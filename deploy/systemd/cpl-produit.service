# Unité systemd du montage (modèle ; chemins à adapter par l'exploitant).
# Démarrage/arrêt/redémarrage : systemctl start|stop|restart cpl-produit
# Santé : curl -fsS https://<PI_PUBLIC_HOST>:<PI_PUBLIC_PORT>/health
# Un redémarrage perd les diagnostics PGDR en cours (sessions en mémoire) ;
# les comptes, sessions web, dossiers et résultats sont conservés (PostgreSQL).
[Unit]
Description=Montage CPL produit (PI-05 public, VIR et PGDR sur la boucle locale)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cpl-produit
Group=cpl-produit
UMask=0077
# Secrets et paramètres (noms : deploy/secrets.env.exemple), fichier root:cpl-produit 0640
EnvironmentFile=/etc/cpl-produit/montage.env
Environment=PATH=/opt/cpl-produit/venv/bin:/usr/bin:/bin
WorkingDirectory=/var/lib/cpl-produit
ExecStart=/opt/cpl-produit/src/pi/scripts/lancer_montage.sh
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
# Port public < 1024 sans root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cpl-produit

[Install]
WantedBy=multi-user.target
