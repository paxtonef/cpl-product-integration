# Noms des secrets et paramètres fournis à l'exécution (gestionnaire de secrets
# ou fichier root:<service> 0640 hors dépôt). AUCUNE valeur ici.
# Secrets
DATABASE_URL=
VIR_SERVICE_TOKEN=
VIR_DATA_ENCRYPTION_KEY=
PGDR_IDENTITY_HANDOFF_TOKEN=
# Compteurs de connexion (HMAC) : 32 caractères au moins ; l'ancien secret pendant un
# renouvellement (au moins 30 minutes), puis retiré
PI_LOGIN_THROTTLE_SECRET=
PI_LOGIN_THROTTLE_SECRET_PREVIOUS=
# Paramètres d'hébergement (inconnus à ce jour, à fixer par l'exploitant)
PI_PUBLIC_HOST=
PI_PUBLIC_PORT=
PI_TLS_CERT=
PI_TLS_KEY=
# Origine exacte du produit (https://hôte[:port]) exigée de toute écriture envoyée par un navigateur
PI_PUBLIC_ORIGIN=
# Seulement si un proxy TLS est placé devant PI : ses adresses (sinon aucun en-tête de proxy n'est cru)
PI_TRUSTED_PROXIES=
# Emplacements persistants
MONTAGE_DIR=
VIR_DATABASE_PATH=
PI05_MEDIA_STORAGE_DIR=
PI_FRONTEND_DIST=
# Décisions du propriétaire (aucune valeur par défaut présentée comme approuvée)
VIR_RETENTION_DAYS=
